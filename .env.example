# API Configuration
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack Configuration
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# Authentication
AUTH_SECRET=replace-with-a-long-random-server-side-secret
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# Initial platform administrator (created only when no platform admin exists)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=use-a-long-unique-password
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Admin
